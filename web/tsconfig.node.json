{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    // scripts/gen-llms-txt.ts reaches into src/, which reads `import.meta.env`.
    "types": ["node", "vite/client"]
  },
  "include": ["vite.config.ts", "../scripts/gen-llms-txt.ts"]
}
